DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Render Postgres provides DATABASE_URL automatically when attached.
# DATABASE_URL=postgres://...

# Optional: persist uploads on a Render Disk (e.g., /var/data/media)
# DJANGO_MEDIA_ROOT=/var/data/media
